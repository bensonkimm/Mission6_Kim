@model IEnumerable<Mission6.Models.Applications>

@{
    ViewData["Title"] = "Movie List";
}

<h2>Movie List</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Year</th>
            <th>Category</th> 
            <th>Edited</th>
            <th>Copied To Plex</th>
            <th>Notes</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Year</td>
                <td>@(movie.Category != null ? movie.Category.CategoryName : "N/A")</td> <!-- Display Category -->
                <td>@movie.Edited</td>
                <td>@movie.CopiedToPlex</td>
                <td>@movie.Notes</td>
                <td>
                    <a asp-action="EditMovie" asp-route-id="@movie.MovieId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="DeleteMovie" asp-route-id="@movie.MovieId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }

</table>

<a asp-action="Create" class="btn btn-primary">Add New Movie</a>
