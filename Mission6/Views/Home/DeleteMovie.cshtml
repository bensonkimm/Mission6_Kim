@model Mission6.Models.Applications

@{
    ViewData["Title"] = "Delete Movie";
}

<h2>Delete Movie</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this movie?
</div>

<div>
    <h4>@Model.Title (@Model.Year)</h4>
    <p>
        <strong>Edited:</strong> @Model.Edited <br />
        <strong>Copied To Plex:</strong> @Model.CopiedToPlex <br />
        <strong>Notes:</strong> @Model.Notes
    </p>
</div>

<form asp-action="DeleteMovie" method="post">
    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
